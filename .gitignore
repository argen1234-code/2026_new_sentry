/install/
/log/
*.bag
*.db3
*.mcap

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/

# ---- CMake ----
build/
cmake-build-*/
CMakeCache.txt
CMakeFiles/

# ---- STM32 / Keil ----
stm32_ws/legacy/Boards/MDK-ARM/Objects/
stm32_ws/legacy/Boards/MDK-ARM/Listings/
stm32_ws/legacy/Boards/MDK-ARM/DebugConfig/
*.uvguix.*
*.uvoptx
*.uvprojx.bak
*.bak
*.o
*.d
*.elf
*.bin
*.hex
*.map
*.lst
*.crf
*.dep
*.axf
*.htm
