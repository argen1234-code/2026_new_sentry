# ---- IDE / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---- TF 调试产物（ros2 run tf2_tools view_frames）----
frames_*.gv
frames_*.pdf

# ---- 本地下载与机器专属文件 ----
.downloads/
# 母工程参考代码（对比基线，不随本仓库提交）
reference/
stm32_ws/backup/
*.local

# ---- 建图副产物（每次 slam 重写，一次往返可到百 MB）----
ros_ws/src/sentry_localization/point_lio/PCD/scans.pcd

# ---- 地图资产 ----
# 整个 maps/ 不入库：先验点云（*_prior.pcd）单文件就 100 MB+，超过 GitHub 100 MiB
# 硬限制；栅格图（*.pgm/*.yaml）虽小，但和点云是同一趟建图的产物，成对存在才有意义。
# 需要时按 docs/ 里的建图流程重跑，或从本地备份取。
maps/

# ---- 录包 ----
# 单包 100 MB–2 GB，永不入库。地图资产在 maps/，录包在 bags/，两者不混放。
bags/

# ---- 外部资料（比赛规则 PDF 等，非本工程产物）----
docs/rules/
